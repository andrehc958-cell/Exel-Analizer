# Copia este archivo como .env.local para desarrollo. Nunca subas claves reales al repositorio.

# --- Interfaz (públicas, se incluyen en el build) ---
VITE_BILLING_ENABLED=false
VITE_PRO_PRICE_LABEL=$199 MXN al mes
# Plan anual y pase de 24 horas: se muestran sólo si tienen etiqueta (y su precio en el servidor)
VITE_PRO_ANNUAL_PRICE_LABEL=$1,990 MXN al año
VITE_PRO_ANNUAL_NOTE=Equivale a 2 meses gratis
VITE_PASS_PRICE_LABEL=$49 MXN por 24 horas
# Enlace de donación con monto libre (p. ej. un Payment Link de Stripe). Vacío = sin donaciones.
VITE_DONATION_URL=

# --- Anuncios (Google AdSense, sólo plan gratuito y con consentimiento) ---
# Vacíos = sin anuncios. El identificador también genera /ads.txt.
VITE_ADSENSE_CLIENT=ca-pub-...
VITE_ADSENSE_SLOT=
# Opcional: página del anuncio en otro dominio (por defecto /anuncio.html en un iframe aislado)
VITE_AD_FRAME_URL=
VITE_LEGAL_OWNER=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_JURISDICTION=

# --- Servidor (secretas, sólo en las variables de entorno del hosting) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO=price_...
# Opcionales: precio recurrente anual y precio de pago único del pase de 24 horas
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_PASS=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Cadena aleatoria larga para firmar las licencias: openssl rand -base64 32
# (opcional: si falta se deriva de la clave de Stripe; APP_URL también es opcional en Vercel)
LICENSE_SECRET=
APP_URL=https://tu-dominio.com

# --- Servicio al cliente y buzón de sugerencias (secretas) ---
# Clave de https://resend.com. Sin ella, los formularios ofrecen escribir por correo.
RESEND_API_KEY=re_...
# Bandeja que recibe los mensajes
CONTACT_TO=soporte@tu-dominio.com
# Remitente verificado en Resend (opcional; por defecto onboarding@resend.dev)
CONTACT_FROM=DataClean <soporte@tu-dominio.com>
